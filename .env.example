# Copy to .env and fill in values. Never commit .env.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SECRET_KEY=replace-with-long-random-string

# Demo OTPs (until SMS is wired)
MANAGER_OTP=325476
EXECUTOR_OTP=123456

REGION_AWS=ap-south-1
AWS_REGION=ap-south-1
ACCESS_KEY_AWS_ID=
AWS_ACCESS_KEY_ID=
SECRET_KEY_AWS=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=exp-tech
S3_BUCKET=exp-tech

# false = upload via API (safer until S3 CORS is set for CloudFront)
S3_BROWSER_UPLOAD=false

# Set after App Runner + CloudFront URLs are known
PUBLIC_BASE_URL=https://YOUR_APP_RUNNER_ID.ap-south-1.awsapprunner.com
CORS_ORIGINS=https://YOUR_CLOUDFRONT_ID.cloudfront.net

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

SEED_DEMO=false
CREATE_TABLES=false

# Creative campaigns
CREATIVE_MAX_TASKS=1000
# Scheduled proof verification (cron, in CREATIVE_VERIFY_TIMEZONE). Empty = disabled.
# Hourly by default; every 2 hours: 0 */2 * * *
# Currently unused: scheduled verification is commented out (app/services/creative_jobs.py).
CREATIVE_VERIFY_CRON=0 * * * *
CREATIVE_VERIFY_TIMEZONE=Asia/Kolkata
CREATIVE_VERIFY_BATCH_SIZE=50
CREATIVE_VERIFY_MAX_ATTEMPTS=3
CREATIVE_OCR_MIN_CONFIDENCE=60
# true = also verify right after an executor uploads (scheduled job still runs)
CREATIVE_VERIFY_ON_UPLOAD=false
CREATIVE_OCR_PROVIDER=tesseract
